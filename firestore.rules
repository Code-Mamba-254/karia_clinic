rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function consultationIdentityUnchanged() {
      return request.resource.data.get('patientId', null) == resource.data.get('patientId', null)
        && request.resource.data.get('doctorId', null) == resource.data.get('doctorId', null)
        && request.resource.data.get('doctorEmail', null) == resource.data.get('doctorEmail', null)
        && request.resource.data.get('doctorName', null) == resource.data.get('doctorName', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    match /patients/{patientId} {
      allow read, create, update, delete: if signedIn();
    }

    match /consultations/{consultationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.doctorId == request.auth.uid
        && request.resource.data.doctorEmail.lower() == request.auth.token.email.lower()
        && exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId));
      allow update: if signedIn() && consultationIdentityUnchanged();
      allow delete: if signedIn()
        && (
          resource.data.get('doctorId', null) == request.auth.uid
          || !existsAfter(/databases/$(database)/documents/patients/$(resource.data.get('patientId', '_')))
        );
    }

    match /counters/{counterId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.value is int
        && request.resource.data.value > 0;
      allow update: if signedIn()
        && request.resource.data.value is int
        && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
